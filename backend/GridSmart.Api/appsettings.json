{
  "ConnectionStrings": {
    "Default": "Server=lpc:.;Database=dongnai_gridsmart;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "GridSmart",
    "Audience": "GridSmart",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "wwwroot/uploads",
    "PublicBasePath": "/uploads",
    "MaxImageMb": 10,
    "ThumbnailSize": 400
  },
  "Ai": {
    "Provider": "Mock",
    "ConfidenceThreshold": 0.6,
    "TimeoutSeconds": 15,
    "OpenAiModel": "gpt-4o-mini",
    "LabelMap": {
      "waste": "WASTE",
      "encroachment": "ENCROACHMENT",
      "infrastructure": "INFRASTRUCTURE",
      "illegal_dump": "ILLEGAL_DUMP"
    },
    "MockKeywords": {
      "WASTE": [ "rác", "rác thải", "xà bần", "phế thải", "bãi rác", "túi rác", "đổ rác", "vứt rác" ],
      "ENCROACHMENT": [ "lấn chiếm", "vỉa hè", "buôn bán", "bán hàng rong", "họp chợ", "chợ tự phát", "quán cóc", "chiếm dụng", "đậu xe", "dựng rạp" ],
      "INFRASTRUCTURE": [ "ổ gà", "nắp cống", "đèn đường", "sụt lún", "hư hỏng", "cây đổ", "gãy", "vỡ", "mặt đường", "lan can", "biển báo" ],
      "ILLEGAL_DUMP": [ "xả thải", "nước thải", "mùi hôi", "ô nhiễm", "xả trộm", "chất thải", "dầu nhớt", "nước bẩn" ]
    }
  },
  "Dedup": {
    "RadiusMeters": 20,
    "WindowHours": 24,
    "PriorityBumpThreshold": 5
  },
  "Resolve": {
    "AfterPhotoToleranceMeters": 50
  },
  "Sla": {
    "ScanIntervalSeconds": 60
  },
  "Pipeline": {
    "RecoveryIntervalMinutes": 5,
    "RecoveryMinAgeMinutes": 1
  },
  "RateLimit": {
    "ReportPer10Min": 5,
    "ReportPerPhonePer10Min": 5,
    "TrackPerMin": 20,
    "LoginPerMin": 10,
    "ClassifyPreviewPerMin": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "logs/gridsmart-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  },
  "AllowedHosts": "*"
}
